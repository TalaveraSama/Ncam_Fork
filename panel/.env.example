# ---------------------------------------------------------------------------
# NCPanel :: configuración de ejemplo  (copiar a .env)
# ---------------------------------------------------------------------------

# Escucha del panel
NCAM_PANEL_HOST=0.0.0.0
NCAM_PANEL_PORT=8080
NCAM_PANEL_DEBUG=0

# Clave de firma de los tokens. Si se deja vacío se genera panel/.secret_key
# Generar una con: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
NCAM_PANEL_SECRET=

# Base de datos SQLite
NCAM_PANEL_DB=backend/data/panel.db

# WebIf del daemon NCam (motor de caché v2)
NCAM_WEBIF_URL=http://127.0.0.1:8181
NCAM_WEBIF_USER=
NCAM_WEBIF_PASSWORD=
NCAM_WEBIF_TIMEOUT=4

# Muestreo periódico de las estadísticas de caché
NCAM_PANEL_CACHE_POLL=1
NCAM_PANEL_CACHE_POLL_INTERVAL=60

# Nombre del panel (aparece en los avisos de caducidad)
NCAM_PANEL_NAME="NCPanel"

# Avisos de caducidad: el planificador arranca con esta variable, pero el envío
# real se controla con los ajustes notify.* de la base de datos (vista Ajustes)
NCAM_PANEL_NOTIFY=1

# Reglas de negocio (créditos)
NCAM_PANEL_LINE_COST=10
NCAM_PANEL_RENEW_COST=10
NCAM_PANEL_LINE_DAYS=30
NCAM_PANEL_RESELLER_CREDITS=100
NCAM_PANEL_DEFAULT_GROUP=1

# CORS (el frontend se sirve desde el propio panel: solo necesario si integra
# el panel en otro dominio)
NCAM_PANEL_CORS_ORIGINS=*

# Seguridad de sesiones
NCAM_PANEL_ACCESS_TTL=1800
NCAM_PANEL_REFRESH_TTL=604800
NCAM_PANEL_MAX_LOGIN_ATTEMPTS=8
NCAM_PANEL_LOGIN_LOCKOUT=300
NCAM_PANEL_PASSWORD_MIN=10
